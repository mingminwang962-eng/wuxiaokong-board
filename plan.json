    {
      "id": 6,
      "name": "迁移、资产与唯一发布候选",
      "gate": "WG6",
      "goal": "装配成同一个可恢复发布对象，消除漂移"
    },
    {
      "id": 7,
      "name": "全量集成、staging Gate 与发布决策",
      "gate": "WG7",
      "goal": "唯一候选完成全量验收，形成可审计 GO/NO-GO"
    }
  ],
  "gates": [
    {
      "id": "WG0",
      "name": "合同可实施",
      "rule": "每个 T 有 P/REQ/TECH/S/WP 映射、写面、验收证据目录和回滚点；关键合同有版本/hash；P0 失败样本可重放"
    },
    {
      "id": "WG1",
      "name": "攻击面受控",
      "rule": "P001/P003/P004 原攻击用例转绿；跨租户不外呼不写入；密钥扫描为零；Cookie/Origin 规则有 E3/E4 证据"
    },
    {
      "id": "WG2",
      "name": "底座合同通过",
      "rule": "空回执不能完成；重放无重复扣费；同 key 异内容 409；迟到响应只审计；重启可接管；ask_user/replan/fail 不按成功结算"
    },
    {
      "id": "WG3",
      "name": "领域闭环",
      "rule": "代表旅程可生成正式成果、幂等保存并回读；五入口不错绑；排期→发布→复盘可追踪；答案可定位 chunk/source"
    },
    {
      "id": "WG4",
      "name": "页面合同通过",
      "rule": "37 正式/3 跳转/1 预览身份正确；零死链缺资源；8 个 dark 页回归；401/403/409/429/5xx 一致；核心旅程双端可完成"
    },
    {
      "id": "WG5",
      "name": "逐请求对账",
      "rule": "重复/失败/取消/超时不多扣漏退；模型与成本可追溯；manual_review 闭环；视频五类失败无模拟成功"
    },
    {
      "id": "WG6",
      "name": "候选对象唯一",
      "rule": "commit/tree、Bundle SHA、migration ledger、registry hashes、asset manifest、环境和回滚对象同一；恢复演练通过"
    },
    {
      "id": "WG7",
      "name": "独立验收通过",
      "rule": "6 个 P0 与适用 P1 达证据门；无阻断 NOT_RUN；回滚有效；观察无未解释异常；逐 P 关闭证据齐全"
    }
  ],
